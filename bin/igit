#!/usr/bin/env ruby

require "reline"
require "shellwords"

loop do
  line = Reline.readline("igit> ", true)

  if line.nil?
    puts
    exit
  end

  case line.chomp
  when "exit", "quit"
    exit
  when ""
    system "git status"
  else
    system "git", *Shellwords.split(line)
  end
rescue Interrupt
end
